# Copy this file to `.env` and fill in your real values there.
# NEVER paste real credentials into chat or commit `.env` to git.

DATABASE_URL=postgresql://user:password@ep-xxxxx.neon.tech/dbname

# Basic auth for the admin panel (change these before deploying)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Escalation threshold in hours for unresolved reports
ESCALATION_HOURS=72

# JWT Authentication
JWT_SECRET_KEY=supersecretkey_change_me_in_prod
